FROM node:20-alpine

WORKDIR /build

# Copy package files
COPY package*.json ./
COPY lerna.json ./
COPY packages packages/

# Install dependencies and build
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps
RUN npm run build

# Create tarball of the CLI package
WORKDIR /build/packages/cli
RUN npm pack

# Output will be in /build/packages/cli/*.tgz
CMD ["sh", "-c", "cp *.tgz /output/"]
